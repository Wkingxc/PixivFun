# Optional. Overrides macOS system proxy detection for Pixiv and pximg requests.
# PIXIVFUN_PROXY="http://127.0.0.1:7890"

# Pximg proxy base URLs
NUXT_PUBLIC_PXIMG_BASEURL_I="/-/"
NUXT_PUBLIC_PXIMG_BASEURL_S="/~/"

# Optional server-only override for the bundled Google Desktop OAuth client.
# Configure both values together. Never use NUXT_PUBLIC_* variables here.
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=

# Google Analytics
NUXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# UA blacklist (JSON array of strings to block)
NUXT_UA_BLACKLIST=[]
