{
  "name": "pixivfun",
  "productName": "PixivFun",
  "version": "1.1.1",
  "description": "面向个人使用的 Pixiv 阅读与本地云同步工具",
  "private": true,
  "main": "desktop/main.mjs",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "desktop:prepare": "node script/prepare-desktop-build.mjs && pwsh -NoProfile -File script/prepare-desktop-icon.ps1",
    "desktop:start": "pnpm desktop:prepare && electron .",
    "desktop:clean": "node script/clean-desktop-release.mjs",
    "desktop:dist": "pnpm build && pnpm desktop:prepare && pnpm desktop:clean && electron-builder --win dir --x64 && node script/finalize-desktop-release.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "test": "node --test tests/*.test.ts",
    "prepare": "nuxt prepare",
    "postinstall": "nuxt prepare",
    "serve": "node .output/server/index.mjs"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.8.34",
    "axios": "^1.18.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.38",
    "vue-gtag": "^3.7.1",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0",
    "vue-waterfall-plugin-next": "^3.0.1"
  },
  "devDependencies": {
    "@iconify-json/fa-solid": "^1.2.2",
    "@iconify-json/noto-v1": "^1.2.5",
    "@nuxtjs/i18n": "^10.4.0",
    "@pinia/nuxt": "^0.11.3",
    "@prettier/plugin-pug": "^3.4.2",
    "@tabler/icons-vue": "^3.44.0",
    "@types/lodash.escaperegexp": "^4.1.9",
    "@types/node": "^24.13.2",
    "@types/nprogress": "^0.2.3",
    "@vue/language-plugin-pug": "^3.3.5",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "cheerio": "^1.2.0",
    "cookie": "^1.1.1",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "lodash.escaperegexp": "^4.1.2",
    "nuxt": "^4.4.8",
    "picocolors": "^1.1.1",
    "prettier": "^3.8.4",
    "pug": "^3.0.4",
    "sass-embedded": "^1.100.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "undici": "^8.5.0",
    "unplugin-icons": "^23.0.1"
  },
  "build": {
    "appId": "fun.pixiv.desktop",
    "artifactName": "PixivFun-${version}-win-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": ".desktop-release"
    },
    "files": [
      "desktop/*.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".output",
        "to": "server"
      },
      {
        "from": "desktop/generated/google-oauth.json",
        "to": "config/google-oauth.json"
      },
      {
        "from": "desktop/generated/PixivFunIcon.png",
        "to": "icon/PixivFunIcon.png"
      }
    ],
    "win": {
      "executableName": "PixivFun",
      "icon": "desktop/generated/PixivFunIcon.png",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "packageManager": "pnpm@11.15.1"
}
